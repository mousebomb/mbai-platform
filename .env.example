# mbai-platform 配置模板
#
# 用法：复制成仓库根目录的 .env，把下面的路径改成自己机器上的。
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库；改完重启服务生效。
#
# 变量前缀统一是 PLATFORM_，对应 platform_core/settings.py 的字段名（大写）。
# 列表型写 JSON；Windows 路径建议用正斜杠，省得写转义。
# 只有选装的引擎（CosyVoice / Qwen3-TTS / FramePack）才需要配置对应的几组变量；
# 不配也不会影响图片/超分这些变体，用到时会在启动前报错并提示缺哪个变量。

# ---------- 权重与数据 ----------
# 模型热池：ComfyUI 的目录约定（diffusion_models/ text_encoders/ vae/ ...）
PLATFORM_MODELS_DIR=D:/models
# 额外只读挂载的权重目录（已有 ComfyUI 安装可以指过去，不复制），JSON 数组
PLATFORM_EXTRA_MODEL_DIRS=[]
# 产物 / SQLite / 日志；默认 <仓库>/data，一般不用改
# PLATFORM_DATA_DIR=D:/mbai-platform/data
# 本地 CLI 工具（realesrgan 等），默认 <仓库>/tools
# PLATFORM_TOOLS_DIR=D:/mbai-platform/tools

# ---------- 引擎与接口 ----------
PLATFORM_COMFY_URL=http://127.0.0.1:8188
PLATFORM_API_URL=http://127.0.0.1:8000
# GPU 单卡串行；多卡再改
PLATFORM_WORKER_CONCURRENCY=1

# ---------- CosyVoice2（audio.tts / audio.voice_clone / audio.voice_design） ----------
# 独立 conda 环境（torch 2.3.1+cu121），由 scripts/bootstrap-cosyvoice.ps1 还原并自动写入 .env
PLATFORM_COSYVOICE_PYTHON=C:/Miniconda3/envs/cosyvoice/python.exe
PLATFORM_COSYVOICE_HOME=D:/engines/CosyVoice/CosyVoice
PLATFORM_COSYVOICE_MODEL=D:/engines/CosyVoice/CosyVoice/pretrained_models/CosyVoice2-0.5B
# 音色目录：<名字>.wav + <名字>.txt（逐字参考文本），文件名即音色名
PLATFORM_COSYVOICE_VOICES=D:/voices
# 音色登记表（`名字|wav路径|参考文本`，一行一个）；没有就删掉这行
PLATFORM_COSYVOICE_CONFIG=D:/voices/config.txt

# ---------- CosyVoice3（audio.tts/cosyvoice3-segmented） ----------
PLATFORM_COSYVOICE3_PYTHON=C:/Miniconda3/envs/cosyvoice3/python.exe
PLATFORM_COSYVOICE3_HOME=D:/engines/CosyVoice3
PLATFORM_COSYVOICE3_MODEL=D:/engines/CosyVoice3/pretrained_models/Fun-CosyVoice3-0.5B

# ---------- Qwen3-TTS VoiceDesign（audio.voice_design/qwen3-voice-design） ----------
PLATFORM_QWEN3_TTS_PYTHON=C:/Miniconda3/envs/qwen3tts/python.exe
PLATFORM_QWEN3_TTS_MODELS=D:/engines/qwen3tts/models

# ---------- FramePack（video.img2video，自带便携 Python） ----------
PLATFORM_FRAMEPACK_PYTHON=D:/engines/framepack/system/python/python.exe
PLATFORM_FRAMEPACK_HOME=D:/engines/framepack/webui
PLATFORM_FRAMEPACK_HF_HOME=D:/engines/framepack/webui/hf_download
