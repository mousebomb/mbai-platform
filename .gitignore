# ---------- 引擎本体：git clone 的第三方仓库，永不入库 ----------
# 只忽略子目录，engines/ 下自己的说明文件仍可提交
#
# 链接（junction / 硬链接 / 符号链接）只允许落在 engines/*/ 或 data/ 这类被忽略的目录里：
# git 不记录 reparse point，跨机器 clone 不会带过去；若落在被跟踪的路径里，
# Git for Windows 会把它当普通目录递归，把权重整个塞进仓库。
engines/*/

# ---------- 运行时数据：SQLite、产物图片、日志 ----------
# 产物（生成的 png/mp4/wav）全部落在这里，不进仓库
data/
*.log

# ---------- 本地 CLI 工具：由 scripts/download-tools.ps1 下载，不入库 ----------
tools/*/

# ---------- Python ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.db

# ---------- 前端 ----------
# 依赖与构建产物由 npm 生成，换机后 npm install && npm run build 复现
node_modules/
apps/web/dist/
*.tsbuildinfo

# ---------- 本地配置与凭据 ----------
.env
.env.*
# 模板必须入库，否则 clone 下来不知道要配什么
!.env.example
# 本机模型绑定：换量化档/魔改模型只改这里，不入库（见 profiles/example.yaml）
profiles/local.yaml
# 本机「把别处的权重链进模型池」的清单，不入库（见 profiles/local-models.example.json）
profiles/local-models.json
# 内部规划稿：含本机磁盘布局与历史决策，只留本地
docs/platform-plan-v1-superseded.md

# ---------- 权重：永远不进代码库，只由 scripts/ 下载 ----------
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.onnx
*.bin
