# ---------- 引擎本体：git clone 的第三方仓库，永不入库 ----------
# 只忽略子目录，engines/ 下自己的说明文件仍可提交
engines/*/

# ---------- 运行时数据：SQLite、产物图片、日志 ----------
# 产物（生成的 png/mp4/wav）全部落在这里，不进仓库
data/
*.log

# ---------- Python ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.db

# ---------- 前端 ----------
# 依赖与构建产物由 npm 生成，换机后 npm install && npm run build 复现
node_modules/
apps/web/dist/
*.tsbuildinfo

# ---------- 本地配置与凭据 ----------
.env
.env.*

# ---------- 权重：永远不进代码库，只由 scripts/ 下载 ----------
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.onnx
*.bin
